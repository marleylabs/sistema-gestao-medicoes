generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario          String    @unique
  nome             String
  senhaHash        String    @map("senha_hash")
  senhaTemporaria  String?   @map("senha_temporaria")
  primeiroLogin    Boolean   @default(false) @map("primeiro_login")
  perfil           String    @default("MEDICAO")
  ativo            Boolean   @default(true)
  avatarArquivo    Bytes?    @map("avatar_arquivo")
  avatarMime       String?   @map("avatar_mime")
  avatarAtualizadoAt DateTime? @map("avatar_atualizado_at") @db.Timestamptz
  tentativasFalhas Int       @default(0) @map("tentativas_falhas")
  bloqueadoAte     DateTime? @map("bloqueado_ate") @db.Timestamptz
  ultimoLoginAt    DateTime? @map("ultimo_login_at") @db.Timestamptz
  onlineAt         DateTime? @map("online_at") @db.Timestamptz
  excluidoAt        DateTime? @map("excluido_at") @db.Timestamptz
  email            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  chatParticipantes ChatParticipante[]
  chatMensagens     ChatMensagem[]

  @@index([ativo])
  @@map("usuarios")
}

model ChatConversa {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chave         String             @unique
  tipo          String             @default("DIRETA")
  titulo        String?
  participantes ChatParticipante[]
  mensagens     ChatMensagem[]
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @default(now()) @map("updated_at") @db.Timestamptz

  @@index([updatedAt(sort: Desc)])
  @@map("chat_conversas")
}

model ChatParticipante {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversaId  String       @map("conversa_id") @db.Uuid
  usuarioId   String       @map("usuario_id") @db.Uuid
  ultimoLidoAt DateTime?   @map("ultimo_lido_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz

  conversa ChatConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  usuario  Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([conversaId, usuarioId])
  @@index([usuarioId])
  @@map("chat_participantes")
}

model ChatMensagem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversaId     String       @map("conversa_id") @db.Uuid
  autorId        String       @map("autor_id") @db.Uuid
  texto          String
  tipoMensagem   String       @default("TEXTO") @map("tipo_mensagem")
  arquivo        Bytes?       @map("arquivo")
  arquivoNome    String?      @map("arquivo_nome")
  arquivoMime    String?      @map("arquivo_mime")
  arquivoTamanho Int?         @map("arquivo_tamanho")
  origem         String?      @unique
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  conversa ChatConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autor    Usuario      @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([conversaId, createdAt])
  @@map("chat_mensagens")
}

model SgcAprovacaoMedicao {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  colaboradorCodigo       String    @map("colaborador_codigo")
  ciclo                   String    @default("2605")
  colaboradorNome         String?   @map("colaborador_nome")
  status                  String    @default("PENDENTE")
  revisaoNumero           Int       @default(0) @map("revisao_numero")
  pontosDiscordancia      String?   @map("pontos_discordancia")
  respostaAdmin           String?   @map("resposta_admin")
  aprovadoAt              DateTime? @map("aprovado_at") @db.Timestamptz
  revisaoSolicitadaAt     DateTime? @map("revisao_solicitada_at") @db.Timestamptz
  reenviadoAt             DateTime? @map("reenviado_at") @db.Timestamptz
  resolvidoAt             DateTime? @map("resolvido_at") @db.Timestamptz
  nfArquivo               Bytes?    @map("nf_arquivo")
  nfArquivoNome           String?   @map("nf_arquivo_nome")
  nfCarregadoAt           DateTime? @map("nf_carregado_at") @db.Timestamptz
  pagoAt                  DateTime? @map("pago_at") @db.Timestamptz
  comprovanteArquivo      Bytes?    @map("comprovante_arquivo")
  comprovanteArquivoNome  String?   @map("comprovante_arquivo_nome")
  comprovanteCarregadoAt  DateTime? @map("comprovante_carregado_at") @db.Timestamptz
  salvoAt                 DateTime? @map("salvo_at") @db.Timestamptz
  observacaoColaborador   String?   @map("observacao_colaborador")
  voltadoAt               DateTime? @map("voltado_at") @db.Timestamptz
  statusConferencia       String    @default("CONCLUIDA") @map("status_conferencia")
  conferenciaArquivo      Bytes?    @map("conferencia_arquivo")
  conferenciaArquivoNome  String?   @map("conferencia_arquivo_nome")
  conferenciaCarregadoAt  DateTime? @map("conferencia_carregado_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([colaboradorCodigo, ciclo], map: "sgc_aprovacoes_medicao_codigo_ciclo_key")
  @@index([status])
  @@index([ciclo])
  @@index([revisaoSolicitadaAt])
  @@index([statusConferencia])
  @@map("sgc_aprovacoes_medicao")
}

model DivergenciaMedicao {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sgcId                       String    @map("sgc_id") @db.Uuid
  colaboradorCodigo           String    @map("colaborador_codigo")
  ciclo                       String
  idMedicaoExistente          String?   @map("id_medicao_existente") @db.Uuid
  nrVale                      String    @map("nr_vale")

  documentoNaoMapeado         Boolean   @default(false) @map("documento_nao_mapeado")
  comparacaoAmbigua           Boolean   @default(false) @map("comparacao_ambigua")
  formatoDivergente           Boolean   @default(false) @map("formato_divergente")
  a1eqDivergente               Boolean   @default(false) @map("a1eq_divergente")
  emissaoDivergente           Boolean   @default(false) @map("emissao_divergente")
  tipoDivergente               Boolean   @default(false) @map("tipo_divergente")

  equipeFormato                String?   @map("equipe_formato")
  equipeA1eqHh                  Decimal?  @map("equipe_a1eq_hh") @db.Decimal(14, 4)
  equipePercentualEmissao       Decimal?  @map("equipe_percentual_emissao") @db.Decimal(8, 4)
  equipeTipo                    String?   @map("equipe_tipo")

  fornecedorFormato             String    @map("fornecedor_formato")
  fornecedorA1eqHh               Decimal   @map("fornecedor_a1eq_hh") @db.Decimal(14, 4)
  fornecedorPercentualEmissao   Decimal   @map("fornecedor_percentual_emissao") @db.Decimal(8, 4)
  fornecedorTipo                 String    @map("fornecedor_tipo")

  status                       String    @default("PENDENTE")
  observacao                   String?
  resolvidoPorUsuarioId         String?   @map("resolvido_por_usuario_id") @db.Uuid
  resolvidoPorNome              String?   @map("resolvido_por_nome")
  resolvidoEm                   DateTime? @map("resolvido_em") @db.Timestamptz

  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([sgcId, nrVale], map: "divergencias_medicao_sgc_nrvale_key")
  @@index([colaboradorCodigo, ciclo])
  @@index([status])
  @@index([sgcId])
  @@map("divergencias_medicao")
}

model Projeto {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigoProjeto  String    @unique @map("codigo_projeto")
  tituloPrimario String?   @map("titulo_primario")
  centroCusto    String?   @map("centro_custo")
  localizacao    String?
  contrato       String?
  medicoes       Medicao[]
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("projetos")
}

model Profissional {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                     String    @unique
  codigo                   String?   @unique
  nomeCompleto             String?   @map("nome_completo")
  cpf                      String?
  razaoSocial              String?   @map("razao_social")
  cnpj                     String?
  email                    String?
  statusColaborador        String?   @map("status_colaborador")
  funcao                   String?
  /// Exclusão administrativa definitiva (Painel Administrativo). Estado explícito — nunca deduzido
  /// a partir de campos vazios. `null` = ativo. Quando preenchido, o Profissional deixa de valer
  /// para qualquer fluxo operacional (seletores, novos pagamentos, e-mails, importação), mas
  /// permanece fisicamente no banco para não quebrar `Medicao.idProfissional`/`idCoordenador`
  /// (onDelete: SetNull) e histórico de medição já registrado.
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz
  deletedById              String?   @map("deleted_by_id") @db.Uuid
  deletedByNome            String?   @map("deleted_by_nome")
  deletedReason            String?   @map("deleted_reason")
  medicoesComoCoordenador  Medicao[] @relation("MedicoesCoordenador")
  medicoesComoProfissional Medicao[] @relation("MedicoesProfissional")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([deletedAt])
  @@map("profissionais")
}

model CadastroFornecedor {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cnpjNormalizado    String    @map("cnpj_normalizado")
  colaboradorCodigo  String?   @map("colaborador_codigo")
  responsavel        String
  razaoSocial        String    @map("razao_social")
  statusContrato     String?   @map("status_contrato")
  objetoContrato     String?   @map("objeto_contrato")
  cargo              String?
  cpf                String?
  cnpj               String?
  email              String?
  telefone           String?
  tipoCt             String?   @map("tipo_ct")
  tipoContrato       String?   @map("tipo_contrato")
  valorHora          Decimal?  @map("valor_hora") @db.Decimal(16, 4)
  valorA1Equivalente Decimal?  @map("valor_a1_equivalente") @db.Decimal(16, 4)
  valorDocumento     Decimal?  @map("valor_documento") @db.Decimal(16, 4)
  valorCondicaoFixa  Decimal?  @map("valor_condicao_fixa") @db.Decimal(16, 4)
  /** "FIXA" (padrão, inclusive para cadastros antigos sem valor gravado) ou "CONDICIONAL_PRODUCAO".
   * Nunca inferir a partir do nome do fornecedor — é dado cadastral explícito. */
  tipoCondicaoFixa            String?   @map("tipo_condicao_fixa")
  valorCondicaoFixaComProducao Decimal? @map("valor_condicao_fixa_com_producao") @db.Decimal(16, 4)
  valorCondicaoFixaSemProducao Decimal? @map("valor_condicao_fixa_sem_producao") @db.Decimal(16, 4)
  /** "DOCUMENTOS" (padrão, inclusive NULL) ou "DOCUMENTOS_AUXILIARES" — qual aba da planilha o ETL
   * considera como produção deste fornecedor. Dado cadastral explícito, nunca inferido por nome,
   * código ou condição fixa (regras independentes). Ver lib/fonte-medicao.ts. */
  fonteMedicao       String?   @map("fonte_medicao")
  inicio             DateTime? @db.Date
  final              DateTime? @db.Date
  statusCadastro     String?   @map("status_cadastro")
  primeiroAditivo    String?   @map("primeiro_aditivo")
  segundoAditivo     String?   @map("segundo_aditivo")
  rawPayload         Json      @default("{}") @map("raw_payload")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([colaboradorCodigo])
  @@index([cnpjNormalizado])
  @@index([final])
  @@map("cadastros_fornecedores")
}

model Medicao {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numeroMedicao      String        @map("numero_medicao")
  idProjeto          String        @map("id_projeto") @db.Uuid
  idCoordenador      String?       @map("id_coordenador") @db.Uuid
  idProfissional     String?       @map("id_profissional") @db.Uuid
  projeto            Projeto       @relation(fields: [idProjeto], references: [id], onDelete: Restrict, onUpdate: Cascade)
  coordenador        Profissional? @relation("MedicoesCoordenador", fields: [idCoordenador], references: [id], onDelete: SetNull, onUpdate: Cascade)
  profissional       Profissional? @relation("MedicoesProfissional", fields: [idProfissional], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// Snapshot do nome exibido no momento em que o Profissional referenciado foi excluído
  /// administrativamente (ver Profissional.deletedAt) — preenchido só nesse momento, nunca na
  /// criação normal da Medicao. Garante que "Histórico de Medições"/Boletim continuem mostrando
  /// quem mediu mesmo depois do cadastro operacional ter sido anonimizado.
  coordenadorNomeSnapshot  String?  @map("coordenador_nome_snapshot")
  profissionalNomeSnapshot String?  @map("profissional_nome_snapshot")
  ciclo              String?
  mesclado           String?
  numeroDocumento    String?       @map("numero_documento")
  evidencia          String?
  dataCadastro       DateTime?     @map("data_cadastro") @db.Date
  formato            String?
  quantidade         Decimal       @default(0) @db.Decimal(14, 4)
  multiplicador      Decimal       @default(0) @db.Decimal(14, 4)
  equivalenteA1Horas Decimal       @default(0) @map("equivalente_a1_horas") @db.Decimal(14, 4)
  porcentagemRevisao Decimal?      @map("porcentagem_revisao") @db.Decimal(8, 4)
  emissaoInicial     Decimal?      @map("emissao_inicial") @db.Decimal(8, 4)
  retornoVale        Decimal?      @map("retorno_vale") @db.Decimal(8, 4)
  encerramento       Decimal?      @db.Decimal(8, 4)
  arquivamento       Decimal?      @db.Decimal(8, 4)
  medidoHoras        Decimal       @default(0) @map("medido_horas") @db.Decimal(14, 4)
  itemQqp            String?       @map("item_qqp")
  valorUnitario      Decimal       @default(0) @map("valor_unitario") @db.Decimal(16, 4)
  valorBruto         Decimal       @default(0) @map("valor_bruto") @db.Decimal(16, 4)
  valorTotal         Decimal       @default(0) @map("valor_total") @db.Decimal(16, 4)
  obs                String?
  valorReajuste      Decimal       @default(0) @map("valor_reajuste") @db.Decimal(16, 4)
  referencia         String?
  percentualEmissao  Decimal?      @map("percentual_emissao") @db.Decimal(8, 4)
  tipo2              String?
  condicao           String?
  valorMedicao       Decimal       @default(0) @map("valor_medicao") @db.Decimal(16, 4)
  sourceRowHash      String        @unique @map("source_row_hash")
  rawPayload         Json          @default("{}") @map("raw_payload")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  @@index([numeroMedicao])
  @@index([dataCadastro])
  @@index([idProjeto])
  @@index([idCoordenador])
  @@index([idProfissional])
  @@index([ciclo])
  @@map("medicoes")
}

model MapaPagamentoContexto {
  ciclo          String    @id
  mesReferencia  String?   @map("mes_referencia")
  producaoLabel  String?   @map("producao_label")
  producaoInicio DateTime? @map("producao_inicio") @db.Date
  producaoFim    DateTime? @map("producao_fim") @db.Date
  atoLabel       String?   @map("ato_label")
  atoCiclo       String?   @map("ato_ciclo")
  ativoMedicao   Boolean   @default(false) @map("ativo_medicao")
  contratos      Json      @default("[]")
  rateio         Json      @default("[]")
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("mapa_pagamento_contexto")
}

model MapaPagamentoItem {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ciclo            String   @default("2605")
  ordem            Int
  ato              String?
  projetistaCodigo String?  @map("projetista_codigo")
  responsavel      String?
  cpfCnpj          String?  @map("cpf_cnpj")
  razaoSocial      String?  @map("razao_social")
  intrSossego      Decimal  @default(0) @map("intr_sossego") @db.Decimal(18, 8)
  salobo           Decimal  @default(0) @db.Decimal(18, 8)
  acg              Decimal  @default(0) @db.Decimal(18, 8)
  escadasAlumar    Decimal  @default(0) @map("escadas_alumar") @db.Decimal(18, 8)
  horas            Decimal  @default(0) @db.Decimal(14, 4)
  valor            Decimal  @default(0) @db.Decimal(16, 4)
  rev              Decimal  @default(0) @db.Decimal(16, 4)
  status           String?
  sourceRowHash    String   @unique @map("source_row_hash")
  rawPayload       Json     @default("{}") @map("raw_payload")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([ciclo])
  @@index([projetistaCodigo])
  @@index([ato])
  @@map("mapa_pagamento_itens")
}

model BmAuxMedicao {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responsavelCodigo   String   @map("responsavel_codigo")
  ciclo               String?
  equivalenteRevisado Decimal  @default(0) @map("equivalente_revisado") @db.Decimal(14, 4)
  valorMedicao        Decimal  @default(0) @map("valor_medicao") @db.Decimal(16, 4)
  sourceRowHash       String   @unique @map("source_row_hash")
  rawPayload          Json     @default("{}") @map("raw_payload")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@index([responsavelCodigo])
  @@index([ciclo])
  @@map("bm_aux_medicoes")
}

model Contrato {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome       String    @unique
  codigo     String?
  descricao  String?
  gestor     String?
  fiscal     String?
  dataInicio DateTime? @map("data_inicio") @db.Date
  dataFim    DateTime? @map("data_fim") @db.Date
  valorTotal Decimal?  @map("valor_total") @db.Decimal(18, 2)
  colunaMapa String?   @map("coluna_mapa")
  ativo      Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([ativo])
  @@map("contratos")
}

model SgcLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sgcId             String?   @map("sgc_id") @db.Uuid
  colaboradorCodigo String    @map("colaborador_codigo")
  ciclo             String?
  usuarioId         String?   @map("usuario_id") @db.Uuid
  usuarioNome       String?   @map("usuario_nome")
  acao              String
  statusAnterior    String?   @map("status_anterior")
  statusNovo        String?   @map("status_novo")
  telaOrigem        String?   @map("tela_origem")
  observacao        String?
  tipoMensagem      String    @default("TEXTO") @map("tipo_mensagem")
  audioArquivo      Bytes?    @map("audio_arquivo")
  audioMime         String?   @map("audio_mime")
  audioNome         String?   @map("audio_nome")
  lidoAt            DateTime? @map("lido_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([sgcId])
  @@index([colaboradorCodigo, ciclo])
  @@index([createdAt(sort: Desc)])
  @@map("sgc_logs")
}

/// Trilha de auditoria persistente e consultável para operações administrativas destrutivas
/// (hoje: exclusão definitiva de fornecedor/colaborador). Nunca grava senha/token/segredo, nem
/// CPF/CNPJ/e-mail completos — só o suficiente para responder quem/quando/o quê.
model AdminAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action         String
  adminId        String   @map("admin_id") @db.Uuid
  adminUsuario   String   @map("admin_usuario")
  adminNome      String   @map("admin_nome")
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id") @db.Uuid
  targetCodigo   String?  @map("target_codigo")
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([action])
  @@index([targetCodigo])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model EmailLog {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event              String
  entityType         String?  @map("entity_type")
  entityId           String?  @map("entity_id")
  intendedRecipients String[] @map("intended_recipients")
  actualRecipients   String[] @map("actual_recipients")
  testMode           Boolean  @map("test_mode")
  subject            String
  provider           String   @default("resend")
  providerMessageId  String?  @map("provider_message_id")
  status             String
  errorMessage       String?  @map("error_message")
  idempotencyKey     String   @map("idempotency_key")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([event])
  @@index([createdAt(sort: Desc)])
  @@index([idempotencyKey])
  @@map("email_logs")
}

model EtlExecucao {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ciclo         String?
  iniciadoAt    DateTime  @default(now()) @map("iniciado_at") @db.Timestamptz
  finalizadoAt  DateTime? @map("finalizado_at") @db.Timestamptz
  status        String    @default("RUNNING")
  rowsProcessed Int?      @map("rows_processed")
  resultado     Json?
  erro          String?

  @@index([ciclo])
  @@map("etl_execucoes")
}
