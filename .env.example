# E-mail transacional (Resend) — ver lib/email/. NUNCA colocar a chave real aqui nem em nenhum
# arquivo versionado; preencher apenas em .env local (não versionado).
RESEND_API_KEY=
RESEND_FROM_EMAIL="En Passant <planejamento@boinga.com.br>"
# Opcional — deixar vazio se não houver caixa de resposta dedicada.
RESEND_REPLY_TO=
EMAIL_ENABLED=true
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=

# CC por categoria de evento (lista separada por vírgula) — ver lib/email/cc-policy.ts.
# BM: BM_AVAILABLE, BM_DIVERGENCE, BM_APPROVED, BM_REVISION_REQUESTED.
EMAIL_BM_CC=
# Financeiro: PAYMENT_READY, PAYMENT_COMPLETED.
EMAIL_FINANCE_CC=

# Botão/CTA de acesso à aplicação nos e-mails OPERACIONAIS de BM/Financeiro (ver
# lib/email/cta-policy.ts). Só o literal "true" habilita; qualquer outro valor mantém desligado.
# PASSWORD_RESET nunca é afetado por esta chave — sempre mantém o link de acesso.
EMAIL_CTA_ENABLED=false
