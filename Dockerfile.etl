FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY etl/requirements.txt ./etl/requirements.txt
RUN pip install --no-cache-dir -r etl/requirements.txt

COPY etl ./etl
COPY database ./database

CMD ["python", "etl/ingest_medicoes.py", "--excel", "/data/source.xlsm", "--create-schema", "--base-sheet", "BASE", "--payment-map-sheet", "MAPA PAGTO", "--bm-aux-sheet", "BM AUX"]
